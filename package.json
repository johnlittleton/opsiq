{
  "name": "opsiq",
  "version": "1.0.15",
  "description": "OpsIQ - Production-ready dock and production management system",
  "main": "dist/electron/main.js",
  "scripts": {
    "dev": "npm run build:electron && concurrently \"npm run dev:server\" \"npm run dev:react\" \"npm run dev:electron\"",
    "dev:cloud": "npm run build:electron && concurrently \"npm run dev:react\" \"npm run dev:electron\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:react": "vite",
    "dev:electron": "wait-on http://localhost:5173 && cross-env NODE_ENV=development electron .",
    "build": "npm run build:react && npm run build:electron && npm run build:server",
    "build:react": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build:server": "npm rebuild better-sqlite3 && tsc -p tsconfig.server.json",
    "start": "node dist/server/server/index.js",
    "start:electron": "electron .",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "postinstall": "electron-builder install-app-deps"
  },
  "keywords": [
    "electron",
    "dock-management",
    "production",
    "kpi"
  ],
  "author": "Slingshot Transportation, Inc",
  "license": "PROPRIETARY",
  "engines": {
    "node": "20.x"
  },
  "devDependencies": {
    "@capacitor/cli": "5.7.8",
    "@types/better-sqlite3": "^7.6.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/node": "^25.5.0",
    "@types/pg": "^8.16.0",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "@types/uuid": "^9.0.7",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^28.1.3",
    "electron-builder": "^24.9.1",
    "postcss": "^8.4.33",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vite": "^5.0.11",
    "wait-on": "^7.2.0"
  },
  "dependencies": {
    "@capacitor/core": "5.7.8",
    "@capacitor/ios": "5.7.8",
    "better-sqlite3": "^11.0.0",
    "clsx": "^2.1.0",
    "cors": "^2.8.5",
    "date-fns": "^3.2.0",
    "electron-updater": "^6.8.3",
    "express": "^4.18.2",
    "framer-motion": "^11.0.3",
    "lucide-react": "^0.309.0",
    "pg": "^8.16.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-gauge-component": "^1.2.27",
    "react-router-dom": "^6.21.2",
    "recharts": "^2.10.4",
    "socket.io": "^4.6.1",
    "socket.io-client": "^4.6.1",
    "uuid": "^9.0.1",
    "zod": "^3.22.4",
    "zustand": "^4.5.0"
  },
  "build": {
    "appId": "com.slingshot.opsiq",
    "productName": "OpsIQ",
    "artifactName": "OpsIQ-Installer.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/OpsIQ.ico"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "assets/OpsIQ.icns",
      "category": "public.app-category.business"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": {
      "provider": "github",
      "owner": "johnlittleton",
      "repo": "opsiq-updates"
    }
  }
}
