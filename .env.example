# Server Configuration
# For development, use localhost
# For production with central server, use the server's IP or domain

# Example for local network:
# VITE_API_URL=http://192.168.1.100:3000

# Example for cloud deployment:
# VITE_API_URL=https://your-domain.com

# Development default (leave empty for localhost)
VITE_API_URL=

# Kiosk assistant text generation
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Kiosk assistant voice output via ElevenLabs
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=l4Coq6695JDX9xtLqXDE
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
